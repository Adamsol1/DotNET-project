@model backend.ViewModels.LogInViewModel
<!-- TODO : Legg til css. -->
@{
    Layout = null;
}

<!DOCTYPE html> 

    <html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewPort" content="width=device-width, initial-scale=1.0">
    <title>Log in</title>

    <link rel="stylesheet" href="~/css/LogInPage.css" />
<!-- TODO : FIks input validering -->
</head>
<body>
    <div class="Background-login">
        <div class="login-box">
            <form asp-controller="Auth" asp-action="Login" method="post">     
                <input asp-for="Username"
                    data-username-field
                    class="input-login username-input" 
                    type="text" 
                    placeholder="Username" 
                />
            <br>
                 <input asp-for="Password"
                    class ="input-login" 
                    type="password" 
                    placeholder="Password" 
                />           
             <br>
                 <button
                    class = "button-login" 
                    type = "submit" 
                    value = "submit"
                    >Log in
                    </button>
            </form>
        </div>
    </div >
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const usernameInput = document.querySelector('[data-username-field], .username-input');
            if (!usernameInput) return;

            const normalizeToLowercase = () => {
                usernameInput.value = (usernameInput.value || '').toLowerCase();
            };

            normalizeToLowercase();

            ['input', 'paste'].forEach((evt) => {
                usernameInput.addEventListener(evt, normalizeToLowercase);
            });

            if (usernameInput.form) {
                usernameInput.form.addEventListener('submit', normalizeToLowercase);
            }
        });
    </script>
</body>
</html>
